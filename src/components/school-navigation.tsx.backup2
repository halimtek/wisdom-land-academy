import Image from 'next/image';
import Link from 'next/link';
import { headers } from 'next/headers';

const navigation = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/academics', label: 'Academics' },
  { href: '/activities', label: 'Activities' },
  { href: '/students', label: 'Students' },
  { href: '/staff', label: 'Our Staff' },
  { href: '/news', label: 'News & Announcements' },
  { href: '/library', label: 'Digital Library' },
  { href: '/contact', label: 'Contact Us' },
];

export async function SchoolNavigation({
  logoImagePath,
  logoImageAlt,
}: {
  logoImagePath: string | null;
  logoImageAlt: string | null;
}) {
  const requestHeaders = await headers();
  const pathname = requestHeaders.get('x-pathname') || '/';

  return (
    <header className="school-header">
      <div className="school-header-inner">
        <Link href="/" className="school-brand" aria-label="Wisdom Land Academy home">
          <Image
            src={logoImagePath ? '/api/site-media/logo' : '/images/wla-emblem.png'}
            alt={logoImageAlt || 'Wisdom Land Academy'}
            width={58}
            height={58}
            unoptimized={Boolean(logoImagePath)}
            priority
          />
          <span className="school-brand-name">
            WISDOM LAND <b>ACADEMY</b>
            <small>GRADES 1–8</small>
          </span>
        </Link>

        <details className="school-nav-disclosure">
          <summary className="school-menu-toggle" aria-label="Open or close navigation">
            <span className="school-menu-icon" aria-hidden="true">☰</span>
            <span className="school-close-icon" aria-hidden="true">✕</span>
          </summary>

          <nav className="school-main-navigation" aria-label="Main navigation">
            {navigation.map(({ href, label }) => {
              const active = href === '/'
                ? pathname === '/'
                : pathname === href || pathname.startsWith(`${href}/`);

              return (
                <Link
                  key={href}
                  href={href}
                  className={active ? 'school-nav-link active' : 'school-nav-link'}
                >
                  {label}
                </Link>
              );
            })}

            <Link className="school-admin-login" href="/login?mode=ADMIN">
              Admin Login ↗
            </Link>
          </nav>
        </details>
      </div>
    </header>
  );
}
